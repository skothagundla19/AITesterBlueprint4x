# Optional. The app is configured through its Settings dialog, which stores values in the
# browser and passes them to the local proxy per request. These are only for running the
# tools headlessly (e.g. a CI trigger) without the UI.
#
# llm.md I-04: real values go in .env, which is git-ignored. Never commit a token.

JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_TOKEN=

# console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

PORT=8787
