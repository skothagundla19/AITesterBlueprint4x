{
  "name": "blast-test-plan-creator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "B.L.A.S.T. Protocol - Test Plan Creator from a Jira ID (Jira + Groq)",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "test": "node --test tests/offline.test.js tests/generate.test.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
